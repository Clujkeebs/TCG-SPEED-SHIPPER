{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["suite/scan/**", "suite/shared/**", "suite/host/**"]
  },
  "deploy": {
    "startCommand": "node suite/scan/build.js suite/scan/dist && node suite/host/server.js suite/scan/dist",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
